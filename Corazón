<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>I love you &lt;3</title>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; width: 100%; height: 100%; overflow: hidden;
    background: #000; font-family: Arial, sans-serif;
  }
  canvas { display: block; width: 100vw; height: 100vh; }
  #start {
    position: fixed; inset: 0; display: grid; place-items: center;
    background: rgba(0,0,0,.78); color: #eaf7ff; z-index: 2;
    padding: 24px; text-align: center;
  }
  #start button {
    border: 1px solid #1e90ff; border-radius: 999px; padding: 13px 24px;
    color: white; background: #06172b; font-size: 16px; cursor: pointer;
    box-shadow: 0 0 20px rgba(30,144,255,.5);
  }
  #start p { max-width: 320px; line-height: 1.5; color: #b8dfff; }
</style>
</head>
<body>
<canvas id="scene" aria-label="Corazón azul formado por palabras brillantes que dicen Love You"></canvas>
<div id="start">
  <div>
    <p>Un corazón de palabras azules brillantes, con “Love You” en el centro.</p>
    <button id="begin">Iniciar animación ✨</button>
    <p style="font-size:12px">Toca para comenzar. Si agregas love_you.mp3 junto a este archivo, también intentará reproducir la música.</p>
  </div>
</div>
<audio id="music" src="love_you.mp3" loop preload="auto"></audio>
<script>
(() => {
  const canvas = document.getElementById('scene');
  const ctx = canvas.getContext('2d');
  const overlay = document.getElementById('start');
  const music = document.getElementById('music');

  const WORDS = ["love you", "Love You", "LOVE YOU"];
  const COLORS = ["#4682b4", "#1e90ff", "#00bfff", "#6495ed", "#4169e1"];
  const CENTER_TEXT = " Love You ";
  const TAU = Math.PI * 2;
  let W = 0, H = 0, dpr = 1, frame = 0, particles = [], outlineSpan = 0, fillStartFrame = 0;
  let started = false, raf = 0;

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth; H = window.innerHeight;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    buildParticles();
  }

  function heartXY(t) {
    const x = 16 * Math.pow(Math.sin(t), 3);
    const y = 13 * Math.cos(t) - 5 * Math.cos(2*t) - 2 * Math.cos(3*t) - Math.cos(4*t);
    return [x, -y];
  }

  function scaleFactor() {
    // Fit the heart to the viewport while retaining a little breathing room.
    return Math.min((W * 0.40) / 16, (H * 0.39) / 17);
  }
  function toScreen(x, y) {
    const s = scaleFactor();
    return [x * s + W / 2, y * s + H / 2];
  }
  function distance(a, b) { return Math.hypot(a[0] - b[0], a[1] - b[1]); }
  function makeParticle(x, y, order, kind) {
    return {
      x, y, order, kind,
      word: WORDS[Math.floor(Math.random() * WORDS.length)],
      color: COLORS[Math.floor(Math.random() * COLORS.length)],
      alpha: 0, flicker: Math.random() * TAU,
      delay: 0, sizeMult: 0.85 + Math.random() * 0.30
    };
  }

  function buildParticles() {
    particles = [];
    const placedOutline = [];
    const nOutline = 160;
    for (let i = 0; i < nOutline; i++) {
      const t = (i / nOutline) * TAU;
      const [bx, by] = heartXY(t);
      const point = toScreen(bx, by);
      if (placedOutline.some(p => distance(point, p) < Math.max(10, W / 70))) continue;
      placedOutline.push(point);
      particles.push(makeParticle(point[0], point[1], i, 'outline'));
    }
    outlineSpan = particles.reduce((m, p) => Math.max(m, p.order), 0);
    const outlineCount = particles.length;
    fillStartFrame = Math.floor(outlineSpan * 1.6) + 30;

    const placedFill = [];
    let attempts = 0, nFill = 130;
    while (placedFill.length < nFill && attempts < nFill * 80) {
      attempts++;
      const t = Math.random() * TAU;
      const r = Math.random() * 0.86;
      const [bx, by] = heartXY(t);
      const point = toScreen(bx * r, by * r);
      if (placedFill.some(p => distance(point, p) < Math.max(12, W / 46))) continue;
      placedFill.push(point);
      const p = makeParticle(point[0], point[1], Math.floor(Math.random() * 321), 'fill');
      p.delay = fillStartFrame + p.order;
      particles.push(p);
    }
    particles.slice(0, outlineCount).forEach(p => { p.delay = Math.floor(p.order * 1.6); });
  }

  function drawGlowText(p) {
    if (p.alpha <= 0) return;
    const flick = p.alpha >= 255 ? 0.75 + 0.25 * Math.sin(frame * 0.04 + p.flicker) : 1;
    const alpha = Math.floor(p.alpha * flick) / 255;
    const baseSize = (p.kind === 'outline' ? 13 : 11) * p.sizeMult;
    ctx.save();
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.font = `bold ${baseSize}px Arial, sans-serif`;
    ctx.globalAlpha = alpha;
    ctx.shadowColor = p.color;
    ctx.shadowBlur = 12;
    ctx.fillStyle = p.color;
    ctx.fillText(p.word, p.x, p.y);
    ctx.shadowBlur = 23;
    ctx.globalAlpha = alpha * 0.35;
    ctx.fillText(p.word, p.x, p.y);
    ctx.restore();
  }

  function drawCenter() {
    const centerStart = fillStartFrame + 200;
    if (frame <= centerStart) return;
    const progress = Math.min(1, (frame - centerStart) / 60);
    const alpha = 1 - Math.exp(-progress * 8);
    const pulse = 1 + 0.025 * Math.sin(frame * 0.05);
    const size = Math.min(42, Math.max(24, W * 0.047)) * pulse;
    ctx.save();
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.font = `bold ${size}px Georgia, serif`;
    ctx.globalAlpha = alpha;
    ctx.fillStyle = '#fffaf5';
    ctx.shadowColor = '#1e90ff';
    ctx.shadowBlur = 24;
    ctx.fillText(CENTER_TEXT, W / 2, H / 2);
    ctx.shadowBlur = 42;
    ctx.globalAlpha = alpha * 0.25;
    ctx.fillText(CENTER_TEXT, W / 2, H / 2);
    ctx.restore();
  }

  function animate() {
    if (!started) return;
    frame++;
    ctx.clearRect(0, 0, W, H);
    for (const p of particles) {
      if (frame > p.delay && p.alpha < 255) {
        p.alpha = Math.min(255, p.alpha + 14 + Math.floor(Math.random() * 5));
      }
      drawGlowText(p);
    }
    drawCenter();
    raf = requestAnimationFrame(animate);
  }

  document.getElementById('begin').addEventListener('click', async () => {
    if (started) return;
    started = true;
    overlay.style.display = 'none';
    try { await music.play(); } catch (_) { /* Music is optional; animation still runs. */ }
    cancelAnimationFrame(raf);
    animate();
  });
  window.addEventListener('resize', resize);
  resize();
})();
</script>
</body>
</html>
